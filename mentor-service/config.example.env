# Copy to .env (or export these) to point the mentor at a real LLM.
# Leave keys empty to run in offline/mock mode (zero setup).

# --- Provider mode ----------------------------------------------------------
# "anthropic" | "openai" | "offline". Leave blank to auto-detect from whichever
# key is present (Anthropic wins, then OpenAI, else offline).
MENTOR_LLM_MODE=

# --- Anthropic (Claude) — the default provider ------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Strong model for teaching; fast model for frequent hints.
MENTOR_MODEL=claude-sonnet-5
MENTOR_MODEL_FAST=claude-haiku-4-5-20251001

# --- OpenAI / OpenAI-compatible gateway (alternative) -----------------------
# If you use these instead, set MENTOR_LLM_MODE=openai (or just provide an
# OpenAI key and no Anthropic key). Works with OpenAI, Azure OpenAI, Ollama's
# OpenAI endpoint, and internal gateways that speak /chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# e.g. MENTOR_MODEL=gpt-5.4  MENTOR_MODEL_FAST=gpt-5.4-mini

# --- Automatic failover -----------------------------------------------------
# If BOTH providers have keys, a failed request on the primary model (timeout,
# empty response, error) automatically retries on the other provider. Set the
# fallback models explicitly, or leave blank to use that provider's defaults.
MENTOR_FAILOVER=1
MENTOR_FALLBACK_MODEL=
MENTOR_FALLBACK_FAST=

# --- Behavior ---------------------------------------------------------------
MENTOR_IDLE_SECONDS=10
MENTOR_REQUEST_TIMEOUT=60

# --- Learner model ----------------------------------------------------------
# Local SQLite file for the persistent per-learner model. Blank -> ~/.codetutor/learner.db
MENTOR_LEARNER_DB=
